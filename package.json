{
  "name": "@private-courses/llms-and-models",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "node scripts/assemble.mjs",
    "build:preview": "node scripts/assemble.mjs --preview",
    "test": "node --test test/*.test.mjs",
    "verify:math": "python3 verification/foundations.py && python3 verification/training-and-transformers.py && python3 verification/systems-and-distribution.py && python3 verification/engineering-practice.py",
    "verify:recovery": "python3 -B verification/adaptation-authoring.py && python3 -B verification/test-adaptation-authoring.py",
    "verify:practicals": "python3 -B verification/practicals.py && python3 -B verification/recovery-practicals.py",
    "verify:visuals": "node verification/visuals.mjs && node verification/systems-visuals.mjs",
    "verify:practical-recovery": "python3 -B verification/recovery-practicals.py",
    "verify:worked": "python3 -B verification/worked-examples.py",
    "verify:worked:broker": "node verification/worked-example-broker.mjs"
  },
  "dependencies": {
    "@course-core/sdk": "https://github.com/roeehrl/course-sdk/releases/download/v0.2.0/course-core-sdk-0.2.0.tgz",
    "@course-core/visuals": "https://github.com/roeehrl/course-core/releases/download/v0.1.3/course-core-visuals-0.1.0.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.64.0",
    "esbuild": "0.28.2",
    "pg": "^8.23.1"
  }
}
